# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE POSTGRESQL (Required - this is the app's only datastore)
# Find these in your Supabase Dashboard -> Project Settings -> API.
# Run supabase-schema.sql (and optionally supabase-seed.sql for demo
# catalogue data) in the Supabase SQL Editor before starting the app.
# Use the service_role key, not the anon key — the server needs full
# read/write access and this value is never sent to the browser.
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# CLOUDINARY: For persistent jewelry media storage and transformations
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="optional_api_key"
CLOUDINARY_API_SECRET="optional_api_secret"

# ADMIN AUTHENTICATION (single admin account, no user database)
ADMIN_SECRET="aura_jewelry_super_secret_jwt_key_2026"
ADMIN_EMAIL="admin@admin.com"
ADMIN_DEFAULT_PASSWORD="admin123"

# GEMINI_API_KEY: Currently unused by any server route — safe to omit
# unless you wire up your own Gemini-powered feature.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

